# ==================================================
# JACRAL Backend - Environment Variables
# ==================================================
# Copy this to .env and fill in your values.

# ----- Application -----
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/jacral
FRONTEND_URL=http://localhost:5173

# ----- JWT -----
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- Payment - Razorpay -----
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----- Payment - Cashfree (optional) -----
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# ----- Email / SMTP -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@jacral.com

# ----- Shiprocket (optional) -----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
